{
  "name": "solo-0038-strataleaf",
  "product": {
    "name": "StrataLeaf",
    "description": "供 Python 服务嵌入的版本化文档数据库；将文档模式、原子多集合写入、历史读版本、索引、变更订阅和副本追赶作为库 API 提供，持久层使用 SQLite WAL。",
    "primary_interface": "Python 嵌入式库 API",
    "core_workflows": [
      "集合模式与名称空间原子生效",
      "扫描已存文档后提交兼容模式",
      "多集合批次共用提交版本且失败零可见",
      "固定版本读取旧文档与删除边界",
      "谓词过滤与游标跨写入保持同一读版本",
      "当前索引候选与完整谓词结果一致",
      "完整提交交付与单调确认",
      "恢复文件中的版本与模式一致",
      "连续提交应用与重复包不重复写入",
      "保留点与消费位置约束安全水位",
      "到期文档产生显式删除提交",
      "同一历史读版本完成分组和数值计算",
      "读后修改受版本前置条件保护",
      "物理完整性与逻辑引用一致性可观察",
      "外部文档流验证后整批导入"
    ]
  },
  "project_shape": "backend",
  "modules": [
    {
      "id": "catalog",
      "path": "strataleaf/catalog.py",
